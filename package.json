{
    "name":  "changmodel",
    "version":  "0.2.6",
    "description":  "模型切换、模型能力配置、固定摘要模型、子 agent 角色路由与输入历史增强。",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib/index.js",
                  "lib/client.js",
                  "lib/subagent-policy.mjs",
                  "scripts/input-history-patch.mjs",
                  "scripts/subagent-dispatch-patch.mjs",
                  "scripts/smoke.mjs",
                  "scripts/subagent-policy.test.mjs",
                  "scripts/profile-dependency-repair.mjs",
                  "cordis.patch.yml",
                  "README.md",
                  "LICENSE"
              ],
    "scripts":  {
                    "check":  "node --check lib/index.js && node --check lib/subagent-policy.mjs",
                    "smoke":  "node scripts/smoke.mjs && node scripts/subagent-policy.test.mjs",
                    "test":  "node --check lib/index.js && node --check lib/subagent-policy.mjs && node scripts/smoke.mjs && node scripts/subagent-policy.test.mjs"
                },
    "engines":  {
                    "node":  "\u003e=18"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web"
                           }
            },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "^4.0.1",
                             "@deepseek-ai/dsh-llm":  "^0.1.1-rc.2"
                         },
    "peerDependenciesMeta":  {
                                 "@deepseek-ai/dsh-llm":  {
                                                          "optional":  true
                                                      }
                             },
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "model",
                     "switch",
                     "models.dev"
                 ],
    "license":  "MIT"
}
